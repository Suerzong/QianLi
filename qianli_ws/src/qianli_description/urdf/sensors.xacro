<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Virtual sensor placements only; not a real hardware installation claim. -->
  <xacro:property name="lidar_height" value="0.25"/>
  <xacro:macro name="qianli_sensors" params="">
    <link name="imu_link"><xacro:sim_frame_inertial/></link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0"/>
    </joint>
    <link name="lidar_link"><xacro:sim_frame_inertial/></link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 ${lidar_height-base_height}"/>
    </joint>
    <gazebo reference="imu_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="lidar_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="imu_link">
      <sensor name="qianli_imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/qianli/imu</topic><gz_frame_id>imu_link</gz_frame_id>
        <imu/>
      </sensor>
    </gazebo>
    <gazebo reference="lidar_link">
      <sensor name="qianli_lidar" type="gpu_lidar">
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <topic>/qianli/scan</topic><gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan><horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
          </horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
