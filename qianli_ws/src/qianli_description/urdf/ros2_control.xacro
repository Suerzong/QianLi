<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel_control_interface" params="name">
    <joint name="${name}_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>
  <xacro:macro name="qianli_control" params="mode controllers_file">
    <ros2_control name="QianLiSystem" type="system">
      <hardware>
        <xacro:if value="${mode == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:if value="${mode == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <!-- Future hardware-layer calibration only. Simulation uses outward
             axes and right-hand positive velocity with multipliers +1. -->
        <param name="fl_direction">1</param><param name="fr_direction">1</param>
        <param name="rl_direction">1</param><param name="rr_direction">1</param>
      </hardware>
      <xacro:wheel_control_interface name="front_left"/>
      <xacro:wheel_control_interface name="rear_left"/>
      <xacro:wheel_control_interface name="rear_right"/>
      <xacro:wheel_control_interface name="front_right"/>
    </ros2_control>
    <xacro:if value="${mode == 'gazebo'}">
      <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controllers_file}</parameters>
          <controller_manager_name>controller_manager</controller_manager_name>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
