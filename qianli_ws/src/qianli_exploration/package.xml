<?xml version="1.0"?>
<package format="3">
  <name>qianli_exploration</name><version>0.4.0</version>
  <description>Sensor-only frontier exploration with safe Nav2 action delegation.</description>
  <maintainer email="suerzong2007@gmail.com">Suerzong</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>visualization_msgs</exec_depend>
  <exec_depend>qianli_training_scenarios</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <test_depend>ament_cmake_test</test_depend>
  <export><build_type>ament_cmake</build_type></export>
