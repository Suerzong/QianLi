# 项目目标平台为 Linux（Ubuntu 24.04），统一 LF 行尾
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

*.yaml text eol=lf

*.yml text eol=lf

*.xacro text eol=lf

*.urdf text eol=lf

*.sdf text eol=lf

*.rviz text eol=lf

*.json text eol=lf

# Preserve frozen policy/config bytes and recorded SHA-256 hashes.
qianli_ws/src/qianli_omni_learning/**/*.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Keep captured validation logs unchanged, including terminal whitespace.
docs/validation/frontier_v04_20261006/*.txt text eol=lf whitespace=-blank-at-eol

docs/validation/coverage_20261007/*.txt text eol=lf whitespace=-blank-at-eol
